# Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler" works well for this)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Groq: console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Set this to your deployed frontend URL once you know it, e.g. https://kokoodi-health.vercel.app
FRONTEND_ORIGIN=*
